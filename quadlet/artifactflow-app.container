# App origin (APP_URL). Serves the authenticated UI and API on
# 127.0.0.1:8080, reachable only through the nginx vhost for the app
# hostname. Keep PublishPort loopback-bound: TRUSTED_PROXIES=REMOTE_ADDR
# assumes the only peer that can reach this port is nginx on this host.
[Unit]
Description=ArtifactFlow app (HTTP, app origin)
Requires=artifactflow-postgres.service artifactflow-storage-init.service artifactflow-image-parser.service
After=artifactflow-postgres.service artifactflow-storage-init.service artifactflow-image-parser.service

[Container]
ContainerName=artifactflow-app
Image=artifactflow-release.image
Network=artifactflow.network
GroupAdd=10001
GroupAdd=10002
GroupAdd=10003
GroupAdd=10004
Volume=artifactflow-image-socket:/run/artifactflow/image-parser:ro
EnvironmentFile=/etc/artifactflow/app.env
Environment=APP_RUNTIME_ROLE=app PORT=8080
PublishPort=127.0.0.1:8080:8080
Volume=artifactflow-storage:/var/www/html/storage/app
Volume=/etc/artifactflow/db-ca.pem:/etc/artifactflow/db-ca.pem:ro,z
# Processor Unix sockets are read-only to the app. The named volumes remain
# harmless and empty for formats that have not been enabled.
Volume=artifactflow-pdf-socket:/run/artifactflow/pdf-processor:ro
Volume=artifactflow-xlsx-socket:/run/artifactflow/xlsx-processor:ro
Volume=artifactflow-docx-socket:/run/artifactflow/docx-processor:ro
HealthCmd=sh /var/www/html/docker/healthcheck-app.sh
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

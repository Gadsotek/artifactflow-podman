# Image parser for the pinned release (v0.2.1, commit below). On every
# release bump: update ARTIFACTFLOW_COMMIT to the new tag's **commit SHA**
# (tags are mutable references and a source tarball carries no signature, so
# the immutable SHA is the strongest pin available for a source archive),
# sync the php base digest below from the release's root Dockerfile, and keep
# the package list in sync with its image-parser stage.
#
# The parser is built from the pinned release source so this repo carries no
# copy of the application source.
#
# Build on the VM:
#   podman build -f Dockerfile.image-parser \
#     -t localhost/artifactflow-image-parser:pinned .
#
# v0.2.1 = tag commit d9dbb6d5c8bfb838a056ff8516c2b3df31bdaaac
ARG ARTIFACTFLOW_COMMIT=d9dbb6d5c8bfb838a056ff8516c2b3df31bdaaac

FROM alpine:3.22 AS source
ARG ARTIFACTFLOW_COMMIT
ADD https://github.com/Gadsotek/artifactflow/archive/${ARTIFACTFLOW_COMMIT}.tar.gz /tmp/artifactflow.tar.gz
RUN mkdir -p /src \
    && tar -xzf /tmp/artifactflow.tar.gz -C /src --strip-components=1

# Keep everything below in sync with the `image-parser` stage of the release's
# root Dockerfile (base digest, packages, user, limits).
FROM php:8.5.9-cli-alpine3.24@sha256:0554eb53778b5316f6b9a3447c9dfa3cf2141c0c02ff816c42cdc9aa240a34aa

RUN apk add --no-cache --virtual .image-parser-build-deps \
        $PHPIZE_DEPS \
        libjpeg-turbo-dev \
        libpng-dev \
    && docker-php-ext-configure gd --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" exif gd \
    && apk add --no-cache \
        ca-certificates \
        "c-ares>=1.34.8-r0" \
        libjpeg-turbo \
        libpng \
        "libcrypto3>=3.5.8-r0" \
        "libssl3>=3.5.8-r0" \
        "openssl>=3.5.8-r0" \
        socat=1.8.1.3-r0 \
    && apk del .image-parser-build-deps

COPY --from=source /src/image-parser /srv/image-parser

RUN addgroup -S -g 10001 image-parser \
    && adduser -S -D -H -u 10001 -G image-parser -s /sbin/nologin image-parser \
    && mkdir -p /run/artifactflow/image-parser \
    && chown image-parser:image-parser /run/artifactflow/image-parser \
    && chmod 0755 /run/artifactflow/image-parser \
    && sed -i 's/mode=0666/mode=0660/' /srv/image-parser/start.sh \
    && chmod 0555 /srv/image-parser/start.sh

WORKDIR /srv/image-parser

USER image-parser

# Keep one normalization process inside the 512 MiB cgroup; scale with
# separate parser containers and memory limits, never a prefork pool.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD ["php", "/srv/image-parser/healthcheck.php"]

CMD ["/srv/image-parser/start.sh"]

# Environment for the artifactflow-postgres unit. Copy to
# /etc/artifactflow/postgres.env, chmod 0600, owner artifactflow.
#
# Single-role cluster: the app user owns the database (same shape as the
# other reference deployment). Generate the password with:
#   openssl rand -base64 32

POSTGRES_DB=artifactflow
POSTGRES_USER=artifactflow_app
# Same value as DB_PASSWORD in app.env.
POSTGRES_PASSWORD=

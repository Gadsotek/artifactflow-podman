# Environment for the networkless XLSX processor. Copy to
# /etc/artifactflow/xlsx-processor.env with mode 0600 only when XLSX is enabled.
#
# Generate with: openssl rand -base64 32
# The same value goes into XLSX_PROCESSOR_SHARED_SECRET in app.env. Never reuse
# any application, signing, parser, PDF, or DOCX secret.

XLSX_PROCESSOR_SHARED_SECRET=

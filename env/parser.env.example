# Environment for the artifactflow-image-parser unit.
# Copy to /etc/artifactflow/parser.env, chmod 0600, owner artifactflow.
#
# Generate with: openssl rand -base64 32
# The same value goes into IMAGE_PARSER_SHARED_SECRET in app.env. It must
# stay EMPTY (pinned in the quadlet units) on artifact-host, worker, and
# scheduler: their boot gate rejects a non-empty value.

IMAGE_PARSER_SHARED_SECRET=

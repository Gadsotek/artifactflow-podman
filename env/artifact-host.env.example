# Restricted database credentials for the artifact-host unit ONLY. The quadlet
# unit loads this file after app.env, so these two values override the
# application-role credentials there. Copy to
# /etc/artifactflow/artifact-host.env, chmod 0600, owner artifactflow.
#
# The role is created and granted after the first migration (README "First
# boot"): the reviewed grant manifest is
# docs/operations/artifact-host-database-grants.sql at the pinned release tag
# in the main repository. It reads pages, versions, external-share state, and
# installation policy, holds UPDATE only on non-authority updated_at columns,
# and uses the separate artifact rate-limit tables. No queues, sessions, users,
# audit/event tables, schema creation, or sequences.
#
# Generate the password with: openssl rand -base64 32

DB_USERNAME=artifactflow_artifact_host
DB_PASSWORD=

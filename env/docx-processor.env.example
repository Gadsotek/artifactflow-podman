# Environment for the networkless DOCX processor. Copy to
# /etc/artifactflow/docx-processor.env with mode 0600 only when DOCX is enabled.
# DOCX also requires the separately credentialed PDF processor.
#
# Generate with: openssl rand -base64 32
# The same value goes into DOCX_PROCESSOR_SHARED_SECRET in app.env. Never reuse
# any application, signing, parser, PDF, or XLSX secret.

DOCX_PROCESSOR_SHARED_SECRET=

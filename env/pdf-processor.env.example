# Environment for the artifactflow-pdf-processor unit. Copy to
# /etc/artifactflow/pdf-processor.env, chmod 0600, owner artifactflow. Only used
# when PDF is enabled (opt-in in the installer); stays empty otherwise.
#
# Generate with: openssl rand -base64 32
# The same value goes into PDF_PROCESSOR_SHARED_SECRET in app.env. Never reuse
# APP_KEY, the artifact signing key, or the image-parser secret. It must stay
# EMPTY (pinned in the quadlet units) on artifact-host, worker, and scheduler.

PDF_PROCESSOR_SHARED_SECRET=

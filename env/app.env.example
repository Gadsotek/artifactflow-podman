# Shared environment for the app-image units (app, artifact-host, worker,
# scheduler). Copy to /etc/artifactflow/app.env, chmod 0600, owner
# artifactflow. Role-specific values (APP_RUNTIME_ROLE, PORT, parser-secret
# blanking) are pinned in the quadlet units and override this file.
#
# Generate each secret independently, never reuse one for another slot:
#   echo "base64:$(openssl rand -base64 32)"    # APP_KEY
#   echo "base64:$(openssl rand -base64 32)"    # ARTIFACT_URL_SIGNING_KEY
#   openssl rand -base64 32                     # DB password
#
# Keep an out-of-band copy of APP_KEY and ARTIFACT_URL_SIGNING_KEY in a
# password manager: losing APP_KEY makes TOTP secrets and encrypted data
# unrecoverable. Neither key is included in database backups.

APP_KEY=
APP_URL=https://flow.example.com
ARTIFACT_URL=https://artifacts.example.com
ARTIFACT_FRAME_ANCESTORS=https://flow.example.com
# Distinct from APP_KEY, the boot gate rejects reuse.
ARTIFACT_URL_SIGNING_KEY=

DB_CONNECTION=pgsql
DB_HOST=artifactflow-postgres
DB_PORT=5432
DB_DATABASE=artifactflow
# Application-role credentials: app, worker, and scheduler. The artifact-host
# unit loads artifact-host.env after this file and overrides these two values
# with its restricted role (see README "First boot").
DB_USERNAME=artifactflow_app
# Same value as POSTGRES_PASSWORD in postgres.env.
DB_PASSWORD=
DB_SSLMODE=verify-full
# Extracted from the postgres container after its first boot and bind-mounted
# into every app-image container by the quadlet units (see README).
DB_SSLROOTCERT=/etc/artifactflow/db-ca.pem

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Leave SESSION_DOMAIN unset: the session cookie stays host-only on the app
# domain and can never cover the artifact origin.

# A deliverable transport is a first-boot requirement (the boot gate refuses
# MAIL_MAILER=log in production). Fill in your SMTP relay, or use Resend:
# MAIL_MAILER=resend plus RESEND_KEY=<key>.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ArtifactFlow

# Trust the immediate peer (host nginx) as the TLS edge. Safe only while the
# container ports stay loopback-bound; artifactflow:doctor emits its
# documented warning for this, expected. See the nginx vhost comments.
TRUSTED_PROXIES=REMOTE_ADDR

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Realtime (Reverb) intentionally off; enabling it later is a separate step
# (another unit plus the REVERB_* set from the release's .env.production.example).
BROADCAST_CONNECTION=null

# Switched to 1 after the first manual migration (see README "First boot").
# Only the app role honors it, artifact-host pins RUN_MIGRATIONS=0.
RUN_MIGRATIONS=0

# Image pipeline (shipped in v0.0.7; active in this deployment). The secret is
# generated with `openssl rand -base64 32` and must match parser.env; it exists
# ONLY here and in parser.env: the quadlet units pin it empty on artifact-host,
# worker, and scheduler, whose boot gate rejects a non-empty value. To run
# without image uploads instead, set IMAGE_PARSER_ENABLED=false and skip the
# parser container entirely.
IMAGE_PARSER_ENABLED=true
IMAGE_PARSER_URL=http://localhost
IMAGE_PARSER_SOCKET_PATH=/run/artifactflow/image-parser/parser.sock
IMAGE_PARSER_SHARED_SECRET=

# PDF artifacts: production-capable and default-off (shipped v0.1.0). This is a
# per-deployment enablement feature, not a plain flag: the release itself is
# hardened, but THIS deployment must be verified before turning it on (see
# README "PDF uploads" and TESTING.md "PDF enablement gate").
#
# The installer wires PDF only if you opt in; it then sets the values below on
# the app role and builds the PDF socket adapter. Single-VM transport is a local Unix
# socket, so PDF_PROCESSOR_URL stays http://localhost and the real path is the
# socket. The secret lives only here and in pdf-processor.env; non-app roles
# pin it empty.
PDF_PROCESSOR_ENABLED=false
# PDF_PROCESSOR_URL=http://localhost
# PDF_PROCESSOR_SOCKET_PATH=/run/artifactflow/pdf-processor/processor.sock
# PDF_PROCESSOR_SHARED_SECRET=
PDF_PROCESSOR_CONNECT_TIMEOUT_SECONDS=2
PDF_PROCESSOR_TIMEOUT_SECONDS=15

# XLSX artifacts: default-off. The installer enables this only when the pinned
# release publishes a dedicated XLSX processor image, then mounts its
# networkless Unix socket into the app. The exact workbook remains private;
# presentation uses only the processor's bounded typed manifest.
XLSX_PROCESSOR_ENABLED=false
# XLSX_PROCESSOR_URL=http://localhost
# XLSX_PROCESSOR_SOCKET_PATH=/run/artifactflow/xlsx-processor/processor.sock
# XLSX_PROCESSOR_SHARED_SECRET=
XLSX_PROCESSOR_CONNECT_TIMEOUT_SECONDS=2
XLSX_PROCESSOR_TIMEOUT_SECONDS=15

# DOCX artifacts: default-off and dependent on PDF. The networkless DOCX
# processor creates a PDF which the app submits to the independently
# credentialed PDFBox processor before storage or presentation.
DOCX_PROCESSOR_ENABLED=false
# DOCX_PROCESSOR_URL=http://localhost
# DOCX_PROCESSOR_SOCKET_PATH=/run/artifactflow/docx-processor/processor.sock
# DOCX_PROCESSOR_SHARED_SECRET=
DOCX_PROCESSOR_CONNECT_TIMEOUT_SECONDS=2
DOCX_PROCESSOR_TIMEOUT_SECONDS=35
